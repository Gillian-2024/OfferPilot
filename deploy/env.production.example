# OfferPilot 生产环境变量 —— 复制为 .env.local 并填真值，切勿提交
# 注意：本文件只是模板，真实密钥只存服务器本机。

# ---- 必填：认证 ----
# 生成：openssl rand -hex 32
JWT_SECRET=
# 生产走 HTTPS，cookie 必须加 secure
COOKIE_SECURE=true

# ---- 必填：数据库 ----
# 密码需与 db/.env 的 POSTGRES_PASSWORD 一致
DATABASE_URL=postgres://offerpilot:<同db/.env密码>@127.0.0.1:5432/offerpilot
# 本地 Docker PG 未开 SSL
PGSSL=disable

# ---- 必填：LLM(线上用智谱官方，公网可达) ----
DEFAULT_PROVIDER=zhipu
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2

# ---- 选填：管理后台白名单(逗号分隔的登录邮箱) ----
ADMIN_USERNAMES=
