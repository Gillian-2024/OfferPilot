# ========== 后端默认模型配置（双轨制：默认读 .env，用户可在前端设置面板覆盖）==========
# Provider 选哪个：openai | claude | domestic（domestic=国内模型，如智谱/通义/OpenAI兼容）
DEFAULT_PROVIDER=openai

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Claude（Anthropic，注意官方 SDK 走 https://api.anthropic.com；若走兼容网关改 BASE_URL）----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ---- 国内模型（以 OpenAI 兼容协议为例，如智谱 GLM / 通义 qwen / DeepSeek）----
DOMESTIC_API_KEY=
DOMESTIC_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DOMESTIC_MODEL=glm-4-flash

# 服务端口
PORT=8787
